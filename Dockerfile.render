# syntax=docker/dockerfile:1

# Production image: Django + Next.js + Nginx + Supervisor.
# Build from the repository root:
#   docker build -f Dockerfile.render -t practice-project .
#
# IMPORTANT:
# - Set `output: "standalone"` in frontend/next.config.js (or next.config.ts).
# - This expects requirements.txt at the repository root, Django in backend/,
#   and the Next.js app in frontend/.
# - Set DJANGO_SETTINGS_MODULE and the production environment variables at runtime.

FROM python:3.12-slim AS python-deps
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /build
COPY requirements.txt .
RUN python -m pip install --upgrade pip \
    && python -m pip install --prefix=/install -r requirements.txt \
    && python -m pip install --prefix=/install gunicorn


FROM node:22-bookworm-slim AS frontend-build
WORKDIR /frontend
COPY frontend/website/package*.json ./
RUN npm ci
COPY frontend/website/ .
# Set this to the public same-origin API path if your build uses a public API URL.
# Prefer relative API paths such as /api/ for a single-public-URL deployment.
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build


FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# Nginx and Supervisor manage the three long-running processes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/supervisor /run/nginx /app/staticfiles /app/media

COPY --from=python-deps /install/ /usr/local/
COPY backend/ /app/backend/
WORKDIR /app/backend
COPY --from=frontend-build /frontend/.next/standalone/ /app/frontend/
COPY --from=frontend-build /frontend/.next/static/ /app/frontend/.next/static/
COPY --from=frontend-build /frontend/public/ /app/frontend/public/

# Nginx template uses ${PORT}; envsubst expands it when the container starts.
COPY docker/render-nginx.conf.template /etc/nginx/templates/render.conf.template
COPY --from=frontend-build /usr/local/bin/node /usr/local/bin/node
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && rm -f /etc/nginx/sites-enabled/default \
    && chown -R www-data:www-data /app/staticfiles /app/media

EXPOSE 10000
ENTRYPOINT ["/entrypoint.sh"]
